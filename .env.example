# Salin file ini menjadi .env lalu isi dengan config dari Firebase Console
# (Project settings → General → Your apps → SDK setup and configuration)
#
# Firebase (Realtime Database + Hosting)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
# databaseURL wajib untuk Realtime Database
# (Firebase Console > Realtime Database, mis. https://xxx-default-rtdb.asia-southeast1.firebasedatabase.app)
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
